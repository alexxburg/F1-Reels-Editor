# Copy to .env and fill in values.
# Secrets + runtime plumbing only. Rendering choices live in config.json
# (copy config.json.example to config.json).

# OpenRouter key used for voiceover synthesis (required by the webapp/CLI).
OPENROUTER_API_KEY=

# Base directory for webapp job data (default: <cwd>/data).
DATA_ROOT=

# Explicit config file location (default search: $CONFIG_PATH,
# <project-root>/config.json, <cwd>/config.json).
CONFIG_PATH=

# AWS credentials for the Job Carrousel DSQL backend (required only for
# the Carrousel window; the app runs fine without them).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional overrides (defaults shown):
# AWS_REGION=eu-north-1
# DSQL_HOST=fbt7qrxfs2egnxik4bq3mbhd.q3dswx3mb4bs.on.aws
# DSQL_USER=admin
# DBNAME=postgres
